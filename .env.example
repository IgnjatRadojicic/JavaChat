# Copy this file to .env and fill in the values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=5431
DB_NAME=javachat
DB_USER=javachat
DB_PASSWORD=change-me

# --- Google login (Google Cloud Console → APIs & Services → Credentials → OAuth client ID)
# Authorized redirect URIs:
#   http://localhost:8080/login/oauth2/code/google
#   https://<your-domain>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Azure OpenAI (Microsoft Foundry resource → Keys and Endpoint) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment names you chose when deploying the models
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- App ---
SERVER_PORT=8080
